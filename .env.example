# Database
DATABASE_URL="postgresql://dipstick:dipstick@localhost:5432/dipstick?schema=public"

# Server
PORT=3001
NODE_ENV=development

# File Storage
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=20

# OCR (optional - uses Tesseract.js which runs in-process)
# No external OCR service required by default

# Cloud Backup (optional)
# S3_ENDPOINT=
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
# S3_BUCKET=dipstick-backups
# S3_REGION=us-east-1

# VIN Decode (optional)
# VIN_DECODE_API_KEY=

# Push Notifications (optional)
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:admin@example.com

# Session (for basic access control on self-hosted)
SESSION_SECRET=change-me-in-production
